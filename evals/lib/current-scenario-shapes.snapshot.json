        "Sure, here's",
        "^---\\r?\\n"
      ]
    }
  },
  {
    "name": "cut-from-spec",
    "skill": "/smithy.cut",
    "prompt": "evals/fixture/specs/cut-eval/cut-eval.spec.md 1",
    "structural_expectations": {
      "required_headings": [
        "## Summary",
        "## Assumptions",
        "## Specification Debt",
        "## PR"
      ],
      "required_patterns": [
        "Origin: spec:SD-[0-9]{3}",
        "\\*\\*Spec folder\\*\\*",
        "https://github\\.com/\\S+/pull/[0-9]+|PR creation failed[^\\n]*artifacts are on disk at"
      ],
      "forbidden_patterns": [
        "I'd be happy to help",
        "Sure, here's",
        "^---\\r?\\n"
      ]
    },
    "timeout": 600,
    "sub_agent_evidence": [
      {
        "agent": "smithy-scout",
        "pattern": "^## Scout Report\\n\\n\\*\\*Depth\\*\\*"
      },
      {
        "agent": "smithy-clarify",
        "pattern": "^[Cc]larif"
      },
      {
        "agent": "smithy-plan-review",
        "pattern": "^[Rr]eview|^[Pp]lan-review"
      }
    ]
  },
  {
    "name": "fix-from-issue",
    "skill": "/smithy.fix",
    "prompt": "Diagnose and fix the failure using only the repository-local evidence below.\nIssue fixture: {{issue_path}}\nCI log fixture: {{ci_log_path}}\n\nRead those files from this temp fixture copy, identify the root cause, make the smallest code change, and run the relevant local verification.\n\nBegin your response with a `## Diagnosis` heading on a line by itself, then give the diagnosis.\n",
    "structural_expectations": {
      "required_headings": [
        "## Diagnosis"
      ],
      "required_patterns": [
        "\\*\\*Error\\*\\*",
        "\\*\\*Cause\\*\\*",
        "\\*\\*Fix\\*\\*",
        "src/index\\.ts",
        "/health",
        "(npm run build|npm test|[Vv]erification)",
        "([Pp]ass|[Pp]assed|[Pp]asses|successful|succeeded)"
      ],
      "forbidden_patterns": [
        "I'd be happy to help",
        "Sure, here's",
        "^---\\r?\\n"
      ]
    },
    "local_fixtures": {
      "issue": "evals/fixture/issues/fix-from-issue-health-check.md",
      "ci_log": "evals/fixture/ci-logs/fix-from-issue-health-check.log"
    }
  },
