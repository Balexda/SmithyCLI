[
  {
    "name": "audit-flawed-spec",
    "skill": "/smithy.audit",
    "prompt": "specs/audit-eval/audit-eval-flawed.spec.md",
    "structural_expectations": {
      "required_headings": [
        "## Audit Report"
      ],
      "required_patterns": [
        "Dependency Order",
        "\\*{0,2}Critical\\*{0,2}",
        "\\*\\*Executive Summary\\*\\*"
      ],
      "forbidden_patterns": [
        "I'd be happy to help",
        "Sure, here's",
        "^---\\r?\\n"
      ]
    }
  },
  {
    "name": "audit-voice-lint",
    "skill": "/smithy.audit",
    "prompt": "specs/audit-voice/audit-voice-tagged.spec.md",
    "structural_expectations": {
      "required_headings": [
        "## Audit Report"
      ],
      "required_patterns": [
        "\\*{0,2}Critical\\*{0,2}",
        "audiance",
        "mermaid",
        "\\*{0,2}Warning\\*{0,2}",
        "\\*\\*Executive Summary\\*\\*"
      ],
      "forbidden_patterns": [
